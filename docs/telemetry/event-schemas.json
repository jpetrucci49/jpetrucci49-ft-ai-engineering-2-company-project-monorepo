{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healthcore.local/telemetry/event-schemas.json",
  "title": "HealthCore telemetry event catalogue",
  "description": "Wrapper: meta + envelope + per-event JSON Schema draft-07 documents. additionalProperties is false on every properties object (allowlist). Validate a captured event against definitions.<event_type>. See docs/telemetry/telemetry-plan.md.",
  "type": "object",
  "required": ["schemaVersion", "taxonomy", "envelope", "events"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taxonomy": { "const": "entity_action" },
    "envelope": { "$ref": "#/definitions/envelope" },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound_order_created",
        "outbound_order_created",
        "stock_threshold_triggered",
        "direct_stock_edit_rejected",
        "supply_expiry_flagged",
        "inventory_validation_failed",
        "outbound_order_rejected",
        "catalogue_viewed",
        "login_failed",
        "login_succeeded",
        "session_expired",
        "api_latency_recorded",
        "frontend_error_uncaught",
        "page_viewed",
        "flow_abandoned",
        "web_vital_recorded"
      ],
      "properties": {
        "inbound_order_created": { "$ref": "#/definitions/inbound_order_created" },
        "outbound_order_created": { "$ref": "#/definitions/outbound_order_created" },
        "stock_threshold_triggered": { "$ref": "#/definitions/stock_threshold_triggered" },
        "direct_stock_edit_rejected": { "$ref": "#/definitions/direct_stock_edit_rejected" },
        "supply_expiry_flagged": { "$ref": "#/definitions/supply_expiry_flagged" },
        "inventory_validation_failed": { "$ref": "#/definitions/inventory_validation_failed" },
        "outbound_order_rejected": { "$ref": "#/definitions/outbound_order_rejected" },
        "catalogue_viewed": { "$ref": "#/definitions/catalogue_viewed" },
        "login_failed": { "$ref": "#/definitions/login_failed" },
        "login_succeeded": { "$ref": "#/definitions/login_succeeded" },
        "session_expired": { "$ref": "#/definitions/session_expired" },
        "api_latency_recorded": { "$ref": "#/definitions/api_latency_recorded" },
        "frontend_error_uncaught": { "$ref": "#/definitions/frontend_error_uncaught" },
        "page_viewed": { "$ref": "#/definitions/page_viewed" },
        "flow_abandoned": { "$ref": "#/definitions/flow_abandoned" },
        "web_vital_recorded": { "$ref": "#/definitions/web_vital_recorded" }
      }
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "country": {
      "type": "string",
      "enum": ["US", "UK"]
    },
    "productCategory": {
      "type": "string",
      "enum": ["medication", "ppe", "consumable", "equipment"]
    },
    "department": {
      "type": "string",
      "enum": [
        "general_consultation",
        "chronic_care",
        "specialty_care",
        "chronic_disease_management",
        "pharmacy"
      ]
    },
    "clinicId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "timestamp",
        "sessionId",
        "userId",
        "event_type",
        "schemaVersion",
        "requestId",
        "properties"
      ],
      "properties": {
        "eventId": { "$ref": "#/definitions/uuid" },
        "timestamp": { "$ref": "#/definitions/isoDateTime" },
        "sessionId": { "type": "string", "minLength": 1 },
        "userId": { "type": ["string", "null"] },
        "event_type": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "requestId": { "$ref": "#/definitions/uuid" },
        "properties": { "type": "object" }
      }
    },
    "eventMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "category",
        "delivery",
        "containsPiiOrPhi",
        "sanitisation",
        "description",
        "schema"
      ],
      "properties": {
        "classification": { "type": "string", "enum": ["mandatory", "identified"] },
        "category": {
          "type": "string",
          "enum": ["inventory", "authentication", "performance", "errors", "navigation"]
        },
        "delivery": { "type": "string", "enum": ["stream", "batch"] },
        "containsPiiOrPhi": { "type": "boolean" },
        "sanitisation": { "type": "string" },
        "description": { "type": "string" },
        "schema": { "type": "object" }
      }
    },
    "inbound_order_created": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "mandatory" },
            "category": { "const": "inventory" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Staff userId only. No patient fields. department omitted." },
            "description": {
              "const": "Clinic registers receipt of supplies from a vendor (POST /inventory/orders/inbound 201)."
            },
            "schema": { "$ref": "#/definitions/schemas/inbound_order_created" }
          }
        }
      ]
    },
    "outbound_order_created": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "mandatory" },
            "category": { "const": "inventory" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": {
              "const": "department is a clinical area enum, never a patient identifier."
            },
            "description": {
              "const": "Clinic registers consumption of a supply in a department (POST /inventory/orders/outbound 201)."
            },
            "schema": { "$ref": "#/definitions/schemas/outbound_order_created" }
          }
        }
      ]
    },
    "stock_threshold_triggered": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "mandatory" },
            "category": { "const": "inventory" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "None beyond envelope staff userId." },
            "description": {
              "const": "Supply stock at or below the configured minimum (low=10, out=0 until per-clinic minima exist)."
            },
            "schema": { "$ref": "#/definitions/schemas/stock_threshold_triggered" }
          }
        }
      ]
    },
    "direct_stock_edit_rejected": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "mandatory" },
            "category": { "const": "inventory" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "No request body. Path only; drop query strings." },
            "description": {
              "const": "Attempt to modify stock outside InboundOrder/OutboundOrder was rejected."
            },
            "schema": { "$ref": "#/definitions/schemas/direct_stock_edit_rejected" }
          }
        }
      ]
    },
    "supply_expiry_flagged": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "mandatory" },
            "category": { "const": "inventory" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "userId null for the job. No patient or batch-patient link." },
            "description": {
              "const": "Product.expiry_date is within 30 days and remaining quantity is greater than zero."
            },
            "schema": { "$ref": "#/definitions/schemas/supply_expiry_flagged" }
          }
        }
      ]
    },
    "inventory_validation_failed": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "inventory" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "M12: loc + type only. Never Pydantic input/ctx." },
            "description": {
              "const": "Inventory request failed schema validation (not insufficient-stock)."
            },
            "schema": { "$ref": "#/definitions/schemas/inventory_validation_failed" }
          }
        }
      ]
    },
    "outbound_order_rejected": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "inventory" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Supply name only; no patient context." },
            "description": {
              "const": "POST /inventory/orders/outbound rejected with insufficient stock (HTTP 400)."
            },
            "schema": { "$ref": "#/definitions/schemas/outbound_order_rejected" }
          }
        }
      ]
    },
    "catalogue_viewed": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "inventory" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Counts only." },
            "description": { "const": "Authenticated operator opened the medical supply catalogue." },
            "schema": { "$ref": "#/definitions/schemas/catalogue_viewed" }
          }
        }
      ]
    },
    "login_failed": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "authentication" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "No email, IP, or password. userId is null." },
            "description": { "const": "Staff login attempt failed." },
            "schema": { "$ref": "#/definitions/schemas/login_failed" }
          }
        }
      ]
    },
    "login_succeeded": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "authentication" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Role enum only; no email." },
            "description": { "const": "Staff login succeeded." },
            "schema": { "$ref": "#/definitions/schemas/login_succeeded" }
          }
        }
      ]
    },
    "session_expired": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "authentication" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Path only. userId null if token already gone." },
            "description": { "const": "AuthGuard redirected an unauthenticated user away from a protected route." },
            "schema": { "$ref": "#/definitions/schemas/session_expired" }
          }
        }
      ]
    },
    "api_latency_recorded": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "performance" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Route templates, not raw URLs with query values." },
            "description": { "const": "Duration of a BFF or FastAPI request." },
            "schema": { "$ref": "#/definitions/schemas/api_latency_recorded" }
          }
        }
      ]
    },
    "frontend_error_uncaught": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "errors" },
            "delivery": { "const": "stream" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "No error.message. Constructor name + digest + route only." },
            "description": { "const": "Unhandled exception in the backoffice UI." },
            "schema": { "$ref": "#/definitions/schemas/frontend_error_uncaught" }
          }
        }
      ]
    },
    "page_viewed": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "navigation" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Internal pathname only; strip query strings." },
            "description": { "const": "Operator viewed a backoffice route (once per session per route)." },
            "schema": { "$ref": "#/definitions/schemas/page_viewed" }
          }
        }
      ]
    },
    "flow_abandoned": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "navigation" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "No form field values." },
            "description": { "const": "A multi-step flow unmounted without a successful submit." },
            "schema": { "$ref": "#/definitions/schemas/flow_abandoned" }
          }
        }
      ]
    },
    "web_vital_recorded": {
      "allOf": [
        { "$ref": "#/definitions/eventMeta" },
        {
          "properties": {
            "classification": { "const": "identified" },
            "category": { "const": "performance" },
            "delivery": { "const": "batch" },
            "containsPiiOrPhi": { "const": false },
            "sanitisation": { "const": "Metric name, numeric value, and route only." },
            "description": { "const": "Web Vital sample for the current backoffice route." },
            "schema": { "$ref": "#/definitions/schemas/web_vital_recorded" }
          }
        }
      ]
    },
    "schemas": {
      "inbound_order_created": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "inbound_order_created" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clinic_id",
                  "country",
                  "product_id",
                  "product_category",
                  "quantity",
                  "vendor_name",
                  "order_id"
                ],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "vendor_name": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "order_id": { "type": "integer", "minimum": 1 },
                  "sku": { "type": "string", "maxLength": 64 }
                }
              }
            }
          }
        ]
      },
      "outbound_order_created": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "outbound_order_created" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clinic_id",
                  "country",
                  "product_id",
                  "product_category",
                  "quantity",
                  "department",
                  "consumption_type",
                  "order_id"
                ],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "department": { "$ref": "#/definitions/department" },
                  "consumption_type": { "type": "string", "enum": ["clinical_use", "expiry_waste"] },
                  "order_id": { "type": "integer", "minimum": 1 },
                  "remaining_stock": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        ]
      },
      "stock_threshold_triggered": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "stock_threshold_triggered" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clinic_id",
                  "country",
                  "product_id",
                  "product_category",
                  "quantity",
                  "threshold_value",
                  "threshold_kind"
                ],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer", "minimum": 0 },
                  "threshold_value": { "type": "integer", "minimum": 0 },
                  "threshold_kind": { "type": "string", "enum": ["low", "out"] },
                  "trigger_order_type": {
                    "type": "string",
                    "enum": ["inbound", "outbound", "scan"]
                  }
                }
              }
            }
          }
        ]
      },
      "direct_stock_edit_rejected": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "direct_stock_edit_rejected" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["http_method", "http_status", "route"],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer" },
                  "http_method": { "type": "string", "enum": ["PATCH", "PUT", "DELETE"] },
                  "http_status": { "type": "integer", "minimum": 400, "maximum": 499 },
                  "route": { "type": "string", "pattern": "^/inventory/" }
                }
              }
            }
          }
        ]
      },
      "supply_expiry_flagged": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "supply_expiry_flagged" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "country",
                  "product_id",
                  "product_category",
                  "quantity",
                  "expiry_date",
                  "days_to_expiry"
                ],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer", "minimum": 0 },
                  "expiry_date": { "type": "string", "format": "date" },
                  "days_to_expiry": { "type": "integer", "minimum": 0, "maximum": 30 },
                  "department": { "$ref": "#/definitions/department" }
                }
              }
            }
          }
        ]
      },
      "inventory_validation_failed": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "inventory_validation_failed" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["route", "error_code"],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer" },
                  "route": { "type": "string" },
                  "field": { "type": "string" },
                  "error_code": { "type": "string" }
                }
              }
            }
          }
        ]
      },
      "outbound_order_rejected": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "outbound_order_rejected" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clinic_id",
                  "country",
                  "product_id",
                  "product_category",
                  "quantity",
                  "available",
                  "requested"
                ],
                "properties": {
                  "clinic_id": { "$ref": "#/definitions/clinicId" },
                  "country": { "$ref": "#/definitions/country" },
                  "product_id": { "type": "integer", "minimum": 1 },
                  "product_category": { "$ref": "#/definitions/productCategory" },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "department": { "$ref": "#/definitions/department" },
                  "available": { "type": "integer", "minimum": 0 },
                  "requested": { "type": "integer", "minimum": 1 },
                  "product_name": { "type": "string", "maxLength": 200 }
                }
              }
            }
          }
        ]
      },
      "catalogue_viewed": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "catalogue_viewed" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["result_count", "out_of_stock_count", "low_stock_count"],
                "properties": {
                  "result_count": { "type": "integer", "minimum": 0 },
                  "out_of_stock_count": { "type": "integer", "minimum": 0 },
                  "low_stock_count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        ]
      },
      "login_failed": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "login_failed" },
              "userId": { "type": "null" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reason"],
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": ["invalid_credentials", "inactive", "malformed", "network_error"]
                  }
                }
              }
            }
          }
        ]
      },
      "login_succeeded": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "login_succeeded" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role"],
                "properties": {
                  "role": { "type": "string", "enum": ["admin", "manager", "user"] }
                }
              }
            }
          }
        ]
      },
      "session_expired": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
              "event_type": { "const": "session_expired" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from_route"],
                "properties": {
                  "from_route": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        ]
      },
      "api_latency_recorded": {
        "allOf": [
          { "$ref": "#/definitions/envelope" },
          {
            "type": "object",
            "properties": {
